# Copy this file to .env and adjust if your TWS Global Configuration differs.

# TWS runs locally, so this is almost always 127.0.0.1.
IBKR_HOST=127.0.0.1

# TWS Live Trading socket port (Global Configuration > API > Settings).
# Use 7497 instead if you point this at TWS Paper Trading.
IBKR_PORT=7496

# Any integer not already in use by another client connected to this TWS instance.
IBKR_CLIENT_ID=1

# --- Background service (service/supervisor.py) ---

# PAPER = fully autonomous, paper account only (hard-enforced, see
#   service/config.py). LIVE = runs the full pipeline but only QUEUES
#   qualifying setups for human review -- never submits/modifies/cancels
#   an order automatically. Defaults to PAPER if unset or unrecognized.
MODE=PAPER

# Master switch for the scan/score/risk pipeline, independent of MODE.
# Defaults to FALSE (owner decision, 2026-08-07): the gate and pullback
# strategies backtested to negative expectancy and the adopted strategy is
# QQQ buy-and-hold, so there is nothing for the loop to usefully act on.
# With this off the service still connects, reconnects and health-checks,
# but never scans, queues or places anything in any mode.
# Set to true only for a strategy re-validated through net_of_commission.py.
SCAN_ENABLED=false

# Separate client id from IBKR_CLIENT_ID above so the service and your own
# interactive scripts can run against the same TWS instance simultaneously.
IBKR_SERVICE_CLIENT_ID=77

# How often (seconds) the service runs a scan cycle during market hours.
POLL_INTERVAL_SECONDS=300

# Run a connectivity/account/market-data health check every N cycles.
HEALTH_CHECK_EVERY_N_CYCLES=3

# Optional: where the service writes rotating logs. Defaults to ./logs.
# SERVICE_LOG_DIR=C:\Medik\logs

# Optional: email alerts (in addition to the Windows toast notification).
# Leave SMTP_HOST unset to disable -- no email will be sent.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=app-specific-password
# SMTP_FROM=you@gmail.com
# SMTP_TO=you@gmail.com
