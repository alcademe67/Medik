# Copy this file to .env and fill in your values. Never commit .env.

# Get a token by messaging @BotFather on Telegram: /newbot
TELEGRAM_BOT_TOKEN=

# Optional — openFDA works without a key, a key only raises the rate limit.
# Get one at https://open.fda.gov/apis/authentication/
OPENFDA_API_KEY=

# --- KuCoin (crypto prices & your balances) ---
# Create keys on kucoin.com: Account > API Management > Create API.
# Tick ONLY the "General" (read) permission for this bot — leave
# Trade, Transfer and Withdraw OFF. Paste all three values here:
KUCOIN_API_KEY=
KUCOIN_API_SECRET=
KUCOIN_API_PASSPHRASE=
# The API version shown when you created the key (usually 2 or 3)
KUCOIN_KEY_VERSION=2

# Your numeric Telegram user id — /balance answers ONLY this user.
# Get it by messaging @userinfobot on Telegram.
TELEGRAM_OWNER_ID=

# --- Auto-trading (signal bot) ---
# MASTER SAFETY SWITCH. Leave false until you have watched the bot trade
# on paper and you mean it. false = announce trades, place nothing.
# true = send REAL market orders (your key needs the Trade permission).
# NOTE: live trading also requires running `python -m bot.golive` — the
# switch alone is not enough.
LIVE_TRADING=false

# --- Live risk controls (bot/risk.py) ---
# MAX_RISK_PER_TRADE=0.01        # risk at most 1% of equity per trade
# MAX_OPEN_POSITIONS=3
# DAILY_LOSS_LIMIT_PCT=5.0       # halt trading for the day past this loss
# MAX_CONSECUTIVE_LOSSES=3       # pause after this many losers in a row
# STOP_ATR_MULT=2.0              # stop-loss = entry - 2*ATR
# TAKE_PROFIT_RR=2.0             # take-profit at 2:1 reward:risk
# MIN_ORDER_USDT=1.0
# ORDER_MIN_INTERVAL_S=1.0       # min seconds between order submissions
# PAPER_EQUITY=1000             # assumed equity for paper mode on an empty account
TRADE_SYMBOL=BTC-USDT
TRADE_FUNDS_PER_ORDER=5      # quote spent per BUY, e.g. 5 USDT. Start tiny.
TRADE_INTERVAL_SECONDS=60    # how often to check for a signal
KLINE_TYPE=5min             # candle size: 1min, 5min, 15min, 1hour, ...
FAST_MA=9
SLOW_MA=21
MAX_DAILY_ORDERS=10          # hard cap so a bug can't drain the account

# --- Trading research engine (trading/ package, Phase 1) ---
# All read-only; no keys required. These just tune the scanner/strategy.
# MIN_DAILY_VOLUME_USDT=1000000   # ignore coins below this 24h volume
# SCANNER_TOP_N=20
# TIMEFRAME=1h                    # 1m,5m,15m,1h,4h,1d...
# EMA_FAST=21
# EMA_SLOW=50
# EMA_TREND=200
# RSI_PERIOD=14
# ATR_STOP_MULT=2.0               # stop-loss = this * ATR
# RISK_REWARD=2.0                 # take-profit = RR * stop distance
# ADX_MIN=20                      # require a real trend

# Optional overrides
# OPENFDA_BASE_URL=https://api.fda.gov
# KUCOIN_BASE_URL=https://api.kucoin.com
# REQUEST_TIMEOUT_SECONDS=10
