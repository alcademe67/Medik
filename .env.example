# KuCoin API credentials - create a key at https://www.kucoin.com/account/api
# Grant only General + Spot Trading permissions; withdrawal permission is
# never needed by this project. Consider enabling the IP allowlist.
KUCOIN_API_KEY=
KUCOIN_API_SECRET=
KUCOIN_API_PASSPHRASE=

# Optional override of the REST endpoint
KUCOIN_BASE_URL=https://api.kucoin.com
