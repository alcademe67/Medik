# Copy this file to .env and fill in your values. Never commit .env.

# Get a token by messaging @BotFather on Telegram: /newbot
TELEGRAM_BOT_TOKEN=

# Optional — openFDA works without a key, a key only raises the rate limit.
# Get one at https://open.fda.gov/apis/authentication/
OPENFDA_API_KEY=

# --- KuCoin (crypto prices & your balances) ---
# Create keys on kucoin.com: Account > API Management > Create API.
# Tick ONLY the "General" (read) permission for this bot — leave
# Trade, Transfer and Withdraw OFF. Paste all three values here:
KUCOIN_API_KEY=
KUCOIN_API_SECRET=
KUCOIN_API_PASSPHRASE=
# The API version shown when you created the key (usually 2 or 3)
KUCOIN_KEY_VERSION=2

# Your numeric Telegram user id — /balance answers ONLY this user.
# Get it by messaging @userinfobot on Telegram.
TELEGRAM_OWNER_ID=

# Optional overrides
# OPENFDA_BASE_URL=https://api.fda.gov
# KUCOIN_BASE_URL=https://api.kucoin.com
# REQUEST_TIMEOUT_SECONDS=10
